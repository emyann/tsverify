{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  // The fixtures are what the verifier is given to read, some written wrong on purpose (a comparison that is always false, a cast it
  // must refuse), so no rule reads them.
  "ignorePatterns": ["fixtures/**"],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // A name that starts with `_` says it is unused on purpose: a law's leading argument, a destructured field left out.
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }
    ],
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [{ "from": "package", "name": ["test", "it", "describe", "suite"], "package": "node:test" }]
      }
    ],
    // A bare sort of strings is in code-unit order, which is what a test comparing two lists as sets wants; one of numbers or tuples is not.
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }],
    // From the suspicious category, the rules that find a bug or needless code rather than a style.
    "preserve-caught-error": "error",
    "no-unmodified-loop-condition": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    // An `as T` or a `!` that tells tsc what it already knows is noise that hides the casts that matter.
    "typescript/no-unnecessary-type-assertion": "error",
    "unicorn/no-array-fill-with-reference-type": "error"
  },
  "overrides": [
    {
      // Effect is an adapter's, never the core's: the verifier reads every other library through TypeScript's checker alone.
      "files": ["src/**"],
      "excludeFiles": ["src/adapters/effect/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["effect", "effect/**"],
                "message": "Only src/adapters/effect imports effect: read what you need of it there, and hand the core what the adapter makes"
              }
            ]
          }
        ]
      }
    },
    {
      // What a test prints is read by the developer who runs it; the messages a person reads are made in src.
      "files": ["test/**"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
