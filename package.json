{
  "name": "tsverify",
  "version": "0.0.0",
  "private": true,
  "description": "Prove laws of ordinary TypeScript for every input, or get an input that breaks one: read from source, solved by Z3.",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "exports": {
    ".": "./src/contract.ts",
    "./effect": "./src/adapters/effect/contract.ts",
    "./api": "./src/api.ts",
    "./mutants": "./src/mutants.ts",
    "./packs/lodash": "./packs/lodash.ts"
  },
  "bin": {
    "tsverify": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "verify": "node src/cli.ts",
    "bench": "node bench/mutants.ts --json bench/results.json",
    "coverage": "node bench/coverage.ts"
  },
  "dependencies": {
    "typescript": "6.0.3",
    "z3-solver": "5.3.2"
  },
  "peerDependencies": {
    "effect": "4.0.6",
    "lodash-es": "4.18.1"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "lodash-es": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.19.2",
    "effect": "4.0.6",
    "lodash-es": "4.18.1"
  }
}
