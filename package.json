{
  "name": "@emyann/tsverify",
  "version": "0.1.0",
  "description": "Prove laws of ordinary TypeScript for every input, or get an input that breaks one: read from source, solved by Z3.",
  "keywords": [
    "typescript",
    "formal-verification",
    "z3",
    "smt",
    "contracts",
    "property-testing"
  ],
  "homepage": "https://github.com/emyann/tsverify#readme",
  "bugs": {
    "url": "https://github.com/emyann/tsverify/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emyann/tsverify.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "exports": {
    ".": {
      "tsverify-source": "./src/contract.ts",
      "types": "./dist/src/contract.d.ts",
      "default": "./dist/src/contract.js"
    },
    "./effect": {
      "tsverify-source": "./src/adapters/effect/contract.ts",
      "types": "./dist/src/adapters/effect/contract.d.ts",
      "default": "./dist/src/adapters/effect/contract.js"
    },
    "./api": {
      "tsverify-source": "./src/api.ts",
      "types": "./dist/src/api.d.ts",
      "default": "./dist/src/api.js"
    },
    "./mutants": {
      "tsverify-source": "./src/mutants.ts",
      "types": "./dist/src/mutants.d.ts",
      "default": "./dist/src/mutants.js"
    },
    "./packs/lodash": {
      "tsverify-source": "./packs/lodash.ts",
      "types": "./packs/lodash.ts",
      "default": "./dist/packs/lodash.js"
    }
  },
  "bin": {
    "tsverify": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "packs/*.ts"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "test": "node --predictable-gc-schedule --conditions=tsverify-source --test test/*.test.ts",
    "verify": "node --predictable-gc-schedule --conditions=tsverify-source src/cli.ts",
    "bench": "node --predictable-gc-schedule --conditions=tsverify-source bench/mutants.ts --json bench/results.json",
    "coverage": "node --predictable-gc-schedule --conditions=tsverify-source bench/coverage.ts"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "z3-solver": "5.3.2"
  },
  "peerDependencies": {
    "effect": "^4.0.6",
    "lodash-es": "^4.17.21"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "lodash-es": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "effect": "4.0.6",
    "hono": "4.13.13",
    "lodash-es": "4.18.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "publishConfig": {
    "access": "public"
  }
}
